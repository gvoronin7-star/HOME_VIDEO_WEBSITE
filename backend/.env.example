# === Server ===
PORT=4000
NODE_ENV=development
# Origins allowed to call the API (CORS). May list several, comma-separated.
CORS_ORIGIN=http://localhost:5173

# Origin the FRONTEND is served from. Public share links and QR codes are built
# from this, so it must be reachable from another device (a phone scanning the QR).
# It is NOT the API address: /share/:id is a client-side route and the backend
# would return 404.
#   Local dev (Vite):  http://localhost:5173
#   Docker (nginx):    http://localhost:3000
PUBLIC_URL=http://localhost:5173

# === Database (PostgreSQL) ===
# For local dev: DB_HOST=localhost
# For Docker:    DB_HOST=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=family_cinema
DB_USER=postgres
DB_PASSWORD=postgres
# true only for managed cloud Postgres (RDS, Heroku, etc.) that requires SSL.
# The Postgres container in docker-compose.yml has no SSL listener — leave false.
DB_SSL=false

# === Redis (for BullMQ queues) ===
# For local dev: REDIS_HOST=localhost
# For Docker:    REDIS_HOST=redis
REDIS_HOST=localhost
REDIS_PORT=6379

# === JWT ===
# Minimum 32 characters. The server refuses to start in production if this is
# empty, too short, or left at one of the example values. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# === File Storage ===
# local | s3
STORAGE_TYPE=local
STORAGE_PATH=./uploads
# S3 (if STORAGE_TYPE=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-1

# === LLM + TTS (OpenAI-compatible endpoint) ===
# One key and one base URL serve both the script and the narration.
# ProxyAPI (Russia, no VPN, RUB billing):
#   OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
# Official OpenAI: leave OPENAI_BASE_URL empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o-mini

# === TTS (Text-to-Speech) ===
# openai — synthesis via the endpoint above. none — deliberate silent track.
TTS_SERVICE=openai
# gpt-4o-mini-tts also honours delivery `instructions`; tts-1 / tts-1-hd do not.
TTS_MODEL=gpt-4o-mini-tts
# mp3 | wav | opus | aac | flac
TTS_FORMAT=mp3

# === FFmpeg ===
FFMPEG_PATH=
FFPROBE_PATH=

# === File limits ===
MAX_FILE_SIZE_MB=10
MAX_PHOTOS=20

# === File retention ===
# Stories older than this — and every file they own — are deleted automatically.
# 0 keeps everything forever (note: the privacy policy promises deletion).
FILE_RETENTION_DAYS=7
# How often the sweep runs, in hours. 0 disables the schedule.
RETENTION_SWEEP_HOURS=6
